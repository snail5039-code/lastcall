{
  "expo": {
    "name": "살려줌",
    "slug": "lastcall",
    "version": "1.0.0",
    "description": "현재 위치와 증상을 바탕으로 가까운 응급실 정보를 안내하는 앱",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-v2.png",
    "scheme": "lastcall",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.snail5039.lastcall",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "현재 위치를 기준으로 가까운 응급실과 거리를 안내하기 위해 위치를 사용합니다."
      }
    },
    "android": {
      "package": "com.snail5039.lastcall",
      "versionCode": 4,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/app-icon-v2.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "현재 위치를 기준으로 가까운 응급실과 거리를 안내하기 위해 위치를 사용합니다."
        }
      ],
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "axpsmt17vb"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a5413c56-d72f-4e2f-ba8f-bc4d440729ed"
      }
    },
    "owner": "parkeui"
  }
}
