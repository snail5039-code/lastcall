# 출시 환경의 실제 운영자 정보로 변경하세요.
# 실제 연락처는 이 파일이 아니라 배포 환경의 환경변수로만 설정합니다.
EXPO_PUBLIC_OPERATOR_NAME=살려줌 운영팀
EXPO_PUBLIC_LOCATION_CONTACT=contact@example.com

# 서버 주소. 비워두면 운영 서버(https://api.lastcall.kro.kr)를 쓴다.
# 로컬 서버로 붙을 때는 .env 가 아니라 .env.development 에 넣는다.
# .env 는 expo export 와 EAS 빌드에서도 읽혀서 운영 APK 에 localhost 가 박힌다.
# 실기기·에뮬레이터에서는 localhost 가 기기 자신을 가리키므로 PC 의 LAN IP 를 쓴다.
#   EXPO_PUBLIC_API_BASE_URL=http://localhost:8080
